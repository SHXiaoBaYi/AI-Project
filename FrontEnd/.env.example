# 前端环境变量示例（复制为 .env.development.local 可覆盖）
#
# 环境对照（源码里不要写死 IP；只放在 env / yml）：
#   本地开发 + 测试 ECS → 47.117.132.161
#   生产 ECS             → 47.117.113.28（http://47.117.113.28/shxby/）
#
# 线上构建不要设置 VITE_UPLOAD_PUBLIC_BASE：uploadUrl 跟当前页面同源拼
#   /shxby/api/uploads/...（打开生产站就是 47.117.113.28，打开测试站就是 47.117.132.161）。
#
# 本地开发默认连测试：
# VITE_API_PROXY_TARGET=http://47.117.132.161/shxby
# VITE_UPLOAD_PUBLIC_BASE=http://47.117.132.161/shxby/api
#
# 改回本机后端：
# VITE_API_PROXY_TARGET=http://127.0.0.1:8080
# VITE_UPLOAD_PUBLIC_BASE=
#
# 临时连生产（慎用）：
# VITE_API_PROXY_TARGET=http://47.117.113.28/shxby
# VITE_UPLOAD_PUBLIC_BASE=http://47.117.113.28/shxby/api

VITE_API_PROXY_TARGET=http://47.117.132.161/shxby
VITE_UPLOAD_PUBLIC_BASE=http://47.117.132.161/shxby/api
