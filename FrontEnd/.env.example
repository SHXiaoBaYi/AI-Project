# 前端环境变量示例（复制为 .env.development.local 可覆盖）
#
# 线上构建不要设置 VITE_UPLOAD_PUBLIC_BASE：uploadUrl 会跟当前页面同源拼
#   /shxby/api/uploads/...，避免生产 H5 误指到测试机导致答疑配图全挂。
#
# 本地开发可代理到测试 ECS，并显式指定附件根：
#   API 代理 → http://121.40.170.82/shxby
#   附件打开 → http://121.40.170.82/shxby/api/uploads/...
#
# 若要改回本机后端：
# VITE_API_PROXY_TARGET=http://127.0.0.1:8080
# VITE_UPLOAD_PUBLIC_BASE=
#
# 临时连生产（慎用）：
# VITE_API_PROXY_TARGET=http://121.40.119.134/shxby
# VITE_UPLOAD_PUBLIC_BASE=http://121.40.119.134/shxby/api

VITE_API_PROXY_TARGET=http://121.40.170.82/shxby
VITE_UPLOAD_PUBLIC_BASE=http://121.40.170.82/shxby/api
