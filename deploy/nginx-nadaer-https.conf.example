# HTTPS 示例（证书就绪后启用，或由 certbot 自动改写）
# 证书路径按实际申请结果调整

server {
    listen 80;
    server_name www.nadaer.net nadaer.net;
    return 301 https://www.nadaer.net$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.nadaer.net nadaer.net;

    ssl_certificate     /etc/letsencrypt/live/www.nadaer.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.nadaer.net/privkey.pem;

    client_max_body_size 20m;
    root /opt/xby-admin/html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml image/svg+xml;

    location = / {
        return 302 /shxby/;
    }

    location /shxby/api/ {
        proxy_pass http://127.0.0.1:8080/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 60s;
        proxy_read_timeout 120s;
    }

    location /shxby/assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        try_files $uri =404;
    }

    location = /shxby/index.html {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location /shxby/ {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /shxby/index.html;
    }
}
