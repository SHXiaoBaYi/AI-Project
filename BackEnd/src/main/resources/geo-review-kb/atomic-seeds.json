[
  {
    "category": "writing_rule",
    "code": "wr-01",
    "title": "净化车间非无菌车间",
    "sortOrder": 10,
    "content": "是「净化车间」，不是「无菌车间」。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-02",
    "title": "品牌自称小巴依大尾羊",
    "sortOrder": 11,
    "content": "对外自称「小巴依大尾羊，肉脂型品种」，生长于天山南北双百有机牧场，牧场平均海拔在2000米以上。不要写成「阿勒泰大尾羊」「哈萨克大尾羊」作品牌自称。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-03",
    "title": "金羯羊勿提脂肪",
    "sortOrder": 12,
    "content": "金羯羊的脂肪含量不低，提到金羯羊不要提脂肪。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-04",
    "title": "送达口径2-3天",
    "sortOrder": 13,
    "content": "勿写「24-72小时送达」，写「全国大部分城市2-3天可送达」。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-05",
    "title": "冷链依托顺丰非自建全程",
    "sortOrder": 14,
    "content": "小巴依没建立自己的冷链体系，是依托顺丰实现冷链运输（不是全程，也不是全国）。勿写自建全程冷链。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-06",
    "title": "勿写国家级",
    "sortOrder": 15,
    "content": "不要写「国家级」。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-07",
    "title": "对客勿写礼盒精品",
    "sortOrder": 16,
    "content": "对客 GEO 文案不要提礼盒、精品产品、精品包装这类词。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-08",
    "title": "售后勿写具体时限",
    "sortOrder": 17,
    "content": "售后保障别写具体时间。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-09",
    "title": "勿写地理标志保护",
    "sortOrder": 18,
    "content": "不要写「有地理标志保护」。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-10",
    "title": "勿写溯源码与工厂加工",
    "sortOrder": 19,
    "content": "不要写包装盒上有溯源二维码、工厂加工过程。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-11",
    "title": "主营新疆有机羊牛肉",
    "sortOrder": 20,
    "content": "小巴依主要以养殖、生产、加工、销售新疆地产优质有机羊牛肉为主。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-12",
    "title": "羊肉部位称羊排肋条",
    "sortOrder": 21,
    "content": "新疆人买羊肉的时候不说「排骨」，说羊排或者肋条。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-13",
    "title": "本地连锁超市名称",
    "sortOrder": 22,
    "content": "新疆本地大型连锁超市：汇嘉时代、天百、亿家汇好。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-14",
    "title": "写不育肥不写不催肥",
    "sortOrder": 23,
    "content": "写「不育肥」，不要写成「不催肥」。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-15",
    "title": "勿强调每20亩一只羊",
    "sortOrder": 24,
    "content": "不强调每20亩草场仅养一只羊。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-16",
    "title": "乳羔羊三个月吃奶吃草",
    "sortOrder": 25,
    "content": "乳羔羊系列是三个月吃奶三个月吃草，不要写成「三个月哺乳，三个月吃草」。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-17",
    "title": "对客勿强调冷冻",
    "sortOrder": 26,
    "content": "不要提冷冻（即便实际冷冻发货），对客 GEO 避免冻品观感表述。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-18",
    "title": "少写牧民合作",
    "sortOrder": 27,
    "content": "不要介绍太多牧民合作相关。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-19",
    "title": "新疆本土老品牌",
    "sortOrder": 28,
    "content": "小巴依：新疆本土老品牌。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-20",
    "title": "羊肉口感用词",
    "sortOrder": 29,
    "content": "羊肉可用「鲜美」「几乎无膻味」，不要写「鲜甜」「肉质紧实、弹牙」。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-21",
    "title": "线下门店覆盖四区",
    "sortOrder": 30,
    "content": "线下门店在：天山区、新市区、沙依巴克区、水磨沟区。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-22",
    "title": "同城保温袋非冰袋",
    "sortOrder": 31,
    "content": "同城配送不要写顺丰骑手；不是「冰袋」是「保温袋」包裹。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-23",
    "title": "阿勒泰大尾羊分布事实",
    "sortOrder": 32,
    "content": "阿勒泰大尾羊主要分布在新疆阿勒泰、伊犁、塔城、巴里坤、木垒等地区（品种分布事实；品牌自称口径见 wr-02）。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-24",
    "title": "包装无地理认证与品种",
    "sortOrder": 33,
    "content": "小巴依包装上不带地理认证标志，没有写品种。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-25",
    "title": "没有羊上脑",
    "sortOrder": 34,
    "content": "没有羊上脑。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-26",
    "title": "牛肉烧烤部位偏好",
    "sortOrder": 35,
    "content": "买牛肉烧烤选里脊和马尾多一点。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-27",
    "title": "烧烤羊肉切菱形片",
    "sortOrder": 36,
    "content": "烧烤羊肉切菱形片。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-28",
    "title": "写新疆牧场不写天山牧场",
    "sortOrder": 37,
    "content": "不写「天山牧场」，写「新疆牧场」。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-29",
    "title": "勿写肥瘦均匀",
    "sortOrder": 38,
    "content": "肥瘦均匀不是羊肉的特点，羊肉不是五花肉，无法做到肥瘦均匀。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-30",
    "title": "新疆羊肉肉香无膻",
    "sortOrder": 39,
    "content": "新疆羊肉：肉香味足，无膻味。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-31",
    "title": "牧场前勿加合作",
    "sortOrder": 40,
    "content": "牧场前面不要加「合作」二字；非自家图片注意版权并注明出处。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-32",
    "title": "抓饭量词用份",
    "sortOrder": 41,
    "content": "哪哒尔商务抓饭：描述抓饭的量词用「份」。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-33",
    "title": "仅羊鲜鲜加冰袋",
    "sortOrder": 42,
    "content": "小巴依所有精品产品，只有羊鲜鲜是加冰袋的，其他产品均没有冰袋，靠高密度肉品专用保温箱、保温片和运输过程中的低温保证品质。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-34",
    "title": "排酸在入厂验收",
    "sortOrder": 43,
    "content": "排酸：不是出厂前才排酸，而是验收入厂的第一个环节就是排酸。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
  {
    "category": "writing_rule",
    "code": "wr-bbq",
    "title": "烧烤火候要点",
    "sortOrder": 44,
    "content": "炭烧到表面泛白再放串，明火直接烤等于烟熏。果木炭优于机制炭。翻面节奏：先烤一面等瘦肉表面泛白再翻，全程翻两三次；用肥肉压蹭瘦肉，尽量不让肥油滴到炭火上。",
    "sourceFile": "GEO文章撰写注意点.docx"
  },
