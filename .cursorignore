# ============================================================
# .cursorignore —— 给 Cursor 索引瘦身，降低 token 消耗
#
# 作用：被这里匹配到的文件不会进入 Cursor 的代码库索引，
#       @codebase / 全库检索 / 自动上下文 也都不会带上它们。
# 注意：手动打开或用 @ 显式点名的文件仍会被读取，这是有意的逃生通道。
# 生效：Cursor Settings → Indexing → Resync Index（或重启窗口）后重建索引。
#
# 本文件只影响 Cursor，不影响 git（版本控制仍以 .gitignore 为准）。
# ============================================================


# ------------------------------------------------------------
# 1. 第三方依赖（本项目最大的 token 黑洞）
#    node_modules 约 465M、4.3w+ 个 js/ts/map 文件，索引它毫无收益
# ------------------------------------------------------------
**/node_modules/
node_modules/
.pnpm-store/
.yarn/
.m2-repo/
.mvn/


# ------------------------------------------------------------
# 2. 构建产物与编译输出
#    注意：这里刻意写成 /BackEnd/target/ 而不是 **/target/，
#    因为 FrontEnd/src/pages/hr/ 下有一个真实的业务目录叫 target，不能误伤
# ------------------------------------------------------------
/BackEnd/target/
**/dist/
**/build/
**/out/
**/coverage/
**/.vite/
**/.turbo/
**/.next/

*.class
*.jar
*.war
*.map
*.min.js
*.min.css
*.chunk.js
*.bundle.js
*.d.ts.map


# ------------------------------------------------------------
# 3. 二进制资源（Cursor 读不懂，只会白烧 token）
#    图片 / 字体 / 音视频
# ------------------------------------------------------------
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.ico
*.webp
*.avif
*.svg

*.woff
*.woff2
*.ttf
*.eot
*.otf

*.mp3
*.mp4
*.mov
*.avi

# 压缩包
*.zip
*.rar
*.7z
*.gz
*.tar


# ------------------------------------------------------------
# 4. Office / PDF 文档（二进制，且动辄几十上百 MB）
#    代表：GEO/GEO优化监测9.18.xlsx（177M）、GEO/内容审核智能体要求/*.pptx、pdf
#          HR/ 下 64 份 PDF
# ------------------------------------------------------------
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx
*.csv


# ------------------------------------------------------------
# 5. 业务资料与数据导出目录（非代码，维护时用 @ 单点引用即可）
#    GEO/        232M —— 需求文档、监测表、品宣素材
#    HR/          20M —— 招聘基础数据、简历 PDF
#    演示截图/    1.9M —— 界面截图
#    视频号 字段/  80K —— 平台数据导出
# ------------------------------------------------------------
/GEO/
/HR/
/演示截图/
/视频号 字段/
/渠道汇总-电商看板 1.0.xlsx


# ------------------------------------------------------------
# 6. 运行时产物、上传目录、临时文件
# ------------------------------------------------------------
/BackEnd/uploads/
**/uploads/
**/tmp/
**/temp/
**/logs/
*.log
*.tsbuildinfo
TmpGeoArticleLook.class
tmp-geo-look-out.txt


# ------------------------------------------------------------
# 7. 锁文件（超大且几乎不提供语义信息）
#    pnpm-lock.yaml 约 167K；只在做依赖升级时临时注释掉下面这行
# ------------------------------------------------------------
pnpm-lock.yaml
package-lock.json
yarn.lock


# ------------------------------------------------------------
# 8. VCS / IDE / 本地缓存
# ------------------------------------------------------------
.git/
.idea/
.vscode/
*.iml
.workbuddy/
.DS_Store
Thumbs.db


# ------------------------------------------------------------
# 9. 白名单：以上规则可能误伤的、必须保留在索引里的内容
#    （放在最后，优先级最高）
# ------------------------------------------------------------
!CLAUDE.md
!README.md
!/docs/**
!/deploy/**
!/scripts/**
!/.cursor/**
!.env.example
!**/*.md
!**/*.sql
